              "blog_sub_template_source" : "blog_post_source",
              "blog_listing_source" : "",
              "root" : false,
              "row" : false,
              "starting_html" : "",
              "blog_post_source" : "<div class=\"container-fluid blogpost-header-banner-wrapper\">\n  <div class=\"row-fluid\">\n    <div class=\"page-center\">\n      <div class=\"span12 blogpost-header-banner\">\n        <h1>{{ content.name }}</h1>\n        \n        {% if content.blog_post_author %}\n                        <div class=\"blog_author_date\">\n                            <div class=\"blog_author\">By <a class=\"author-link\" href=\"{{ blog_author_url(group.id, content.blog_post_author.slug) }}\">{{ content.blog_post_author.display_name }}</a></div>\n                           \n                        </div>\n        {% endif %}  \n        \n          <div class=\"list_tags\">\n              {% for topic in content.topic_list %}\n                 <a class=\"blog-category-tag\" href=\"{{ blog_tag_url(group.id, topic.slug) }}\">{{ topic.name }}</a>\n              {% endfor %}\n             <span class=\"blog_date_pub\">{{ content.updated|datetimeformat('%B %e, %Y') }}</span>\n            \n          </div>\n        <p>\n              {% text \"sub_heading\" label=\"Sub-Header Text\", value=\"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla, ut commodo diam libero vitae erat. \" %}\n        </p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div class=\"blog-section\">\n    <div class=\"blog-post-wrapper cell-wrapper\">\n        \n        <div class=\"section post-body\">\n           <div class=\"max-width-850 m-auto\"> \n            {{ content.post_body }}\n           </div>\n          \n          {% module \"module_157864722515231\" path='/1 Clients/ADT Live Asset - Hub/Modules/ADT - Blog Post CTA', label=\"ADT - Blog Post CTA\" %}\n          \n          {# social share buttons #}\n          <div class=\"max-width-850 m-auto\">\n            \n           <div class=\"social_sharing\" id=\"social_sharing\">\n             <p class=\"social_sharing-label\"> Share This Post </p>\n                    {% widget_block social_sharing \"my_social_sharing\" label='Social Sharing', use_page_url=True, overrideable=True  %}\n                            \n                            {% widget_attribute \"twitter\" is_json=True %}{\"custom_link_format\": \"\", \"enabled\": true, \"network\": \"twitter\", \"img_src\": \"https://cdn2.hubspot.net/hubfs/2115715/ADT%20Blog/Social%20Icons/5e0f3c78452ae7625c6dbffd_home-socicon1.png\"}{% end_widget_attribute %}\n                            {% widget_attribute \"linkedin\" is_json=True %}{\"custom_link_format\": \"\", \"enabled\": true, \"network\": \"linkedin\", \"img_src\": \"https://cdn2.hubspot.net/hubfs/2115715/ADT%20Blog/Social%20Icons/5e0f3c78452ae70fe46dc000_001-linkedin-logo.svg\"}{% end_widget_attribute %}\n                            {% widget_attribute \"facebook\" is_json=True %}{\"custom_link_format\": \"\", \"enabled\": true, \"network\": \"facebook\", \"img_src\": \"https://cdn2.hubspot.net/hubfs/2115715/ADT%20Blog/Social%20Icons/5e0f3c78452ae7d40a6dbfff_002-facebook-logo.svg\"}{% end_widget_attribute %}\n                            {% widget_attribute \"email\" is_json=True %}{\"custom_link_format\": \"\", \"enabled\": true, \"network\": \"email\", \"img_src\": \"https://cdn2.hubspot.net/hubfs/2115715/ADT%20Blog/Social%20Icons/001-envelope.svg\"}{% end_widget_attribute %}\n             \n                    {% end_widget_block %}                    \n             </div>{# social sharing #}\n            \n            {# author section #}\n            <div class=\"quote-wrap w-clearfix\">\n                <div class=\"span4\">\n                  <div class=\"quote-image\" style=\"background-image:url({{ content.blog_post_author.avatar }})\"></div>\n                </div>\n                <div class=\"span8-3\">\n                  <div class=\"testimonial-text-wrapper\">\n                    <h3 class=\"m-0\">{{ content.blog_post_author.display_name }}</h3>\n                    {#<p class=\"text-opacity\">Head of Marketing at HubSnacks</p>#}\n                    <p class=\"about-author-desc\">{{ content.blog_post_author.bio }}</p>\n                    <a href=\"{{ group.absolute_url }}/author/{{ content.blog_post_author.slug }}\" class=\"basic-link\">View All Articles</a>\n                  </div>\n                </div>\n            </div>\n           \n          </div> {#max-width-850#}\n          \n     \n      \n\n        </div>{# post body #}\n        \n    </div>\n</div>  \n\n{# MORE ON THIS TOPIC SECION #}\n<div class=\"container-fluid post-by-topic-wrap\">\n  <div class=\"row-fluid\">\n    <div class=\"page-center\">\n      <div class=\"span12\">\n        <!-- Recent Posts -->\n      <div class=\"recent_posts_wrapper\">\n        <div class=\"headting_title clearfix\">\n          <h3>MORE ON THIS TOPIC</h3>\n          {#<a href=\"{{ group.absolute_url }}/all\">More like this</a>#}\n        </div>\n        {# simple_list_page indicates the \"blog/all\" page, which is a list of links to every blog post #}\n        <div class=\"post_listing clearfix \">\n          {% set tag_posts = blog_recent_tag_posts('{{ group.id }}', content.topic_list[0].name|lower|replace(' ','-'), 3) %}\n          \n          {% for tag_content in tag_posts|rejectattr('id','equalto', content.id)   %}\n          <div class=\"post_item\" data-id=\"{{ tag_content.id }} \">\n            \n            {% if tag_content.featured_image%}\n            <div class=\"list_featured_img_wrapper\">\n              <a href=\"{{tag_content.absolute_url}}\" title=\"\" class=\"list_img_link\">\n                <img alt=\"{{ tag_content.name }}\" src=\"{{ tag_content.featured_image }}\" class=\"list_featured_img\">\n              </a>\n            </div>\n            {% endif %}\n            <div class=\"list_tags\">\n              {% for topic in tag_content.topic_list %}\n                 <a class=\"blog-category-tag\" href=\"{{ blog_tag_url(group.id, topic.slug) }}\">{{ topic.name }}</a>\n             {% endfor %}\n            </div>\n            <div class=\"list_post_body clearfix\">\n              <!--post summary-->\n              <div class=\"post_header\">\n                <h2><a href=\"{{tag_content.absolute_url}}\">{{ tag_content.name }}</a></h2>\n              </div>\n              <div class=\"list_preview_text\">\n                {{ tag_content.post_list_content|truncatehtml(150, '...' , false) }}\n                <a class=\"list_preview_a\" href=\"{{tag_content.absolute_url}}\"></a>\n              </div>\n            </div>\n\n         \n          </div>\t\n          {% endfor %}\n        </div>\n       \n      </div>{#recent post wrapper #}\n      </div>\n    </div>\n    \n  </div>\n</div>",
