        "name" : "module_1573215363911151",
        "label" : "Main Listing",
        "type" : "custom_widget",
        "params" : {
          "css_style" : "",
          "template_to_edit" : "listing",
          "css_id" : "",
          "css_class" : "main-listing-sec",
          "schema_version" : 2,
          "path" : "@hubspot/blog_content",
          "per_widget_wrapper_html" : "",
          "blog_listing_source" : "<div class=\"body-listing-section\">\n  <div class=\"all-topics\">\n    <div class=\"max1080\">\n      {% set tag_lists = blog_tags('{{ group.id }}', 250) %}\n      <div class=\"tag_lists\">\n        <a class=\"all-posts-link\" href=\"{{ blog_all_posts_url(group.id) }}\">All</a>\n        {% for item in tag_lists %}\n        <a href=\"{{ blog_tag_url(group.id, item.slug) }}\">{{ item }}</a>\n        {% endfor %}\n      </div>\n    </div>\n  </div>\n  <div class=\"post-listing-wrapper\">\n    <div class=\"max1080\">\n      <div class=\"post-listing clearfix\">\n        {% for content in contents %}\n        <div class=\"post-item\">\n          <div class=\"post-inner\">  \n            <div class=\"inner\">\n              {% if not simple_list_page %}\n              <div class=\"post-featured-img\" style=\"background-image: url('{{ content.post_list_summary_featured_image }}');\">\n                <div class=\"post-date\">\n                  <div class=\"month\">{{ content.publish_date|datetimeformat('%B') }}</div>\n                  <div class=\"day\">{{ content.publish_date|datetimeformat('%e') }}</div>\n                  <div class=\"year\">{{ content.publish_date|datetimeformat('%Y') }}</div>\n                </div>\n                <a href=\"{{ content.absolute_url }}\" class=\"a-link\"></a>\n              </div>\n              <div class=\"post-body\">                \n                {% if content.topic_list %}\n                <div id=\"topic-items\">\n                  {% for topic in content.topic_list %}\n                  <a class=\"topic-item\" href=\"{{ blog_tag_url(group.id, topic.slug) }}\">{{ topic.name }}</a>\n                  {% endfor %}\n                </div>\n                {% endif %}\n                <h3><a href=\"{{ content.absolute_url }}\">{{ content.name }}</a></h3>\n                <div class=\"preview-text\">{{ content.post_list_content|safe|striptags  }}</div>\n              </div>                \n              {% else %}\n\n              <!-- All Listing -->          \n              <div class=\"post-featured-img\" style=\"background-image: url('{{ content.post_list_summary_featured_image }}');\">\n                <div class=\"post-date\">\n                  <div class=\"month\">{{ content.publish_date|datetimeformat('%B') }}</div>\n                  <div class=\"day\">{{ content.publish_date|datetimeformat('%e') }}</div>\n                  <div class=\"year\">{{ content.publish_date|datetimeformat('%Y') }}</div>\n                </div>\n                <a href=\"{{ content.absolute_url }}\" class=\"a-link\"></a>\n              </div>\n              <div class=\"post-body\">                \n                {% if content.topic_list %}\n                <div id=\"topic-items\">\n                  {% for topic in content.topic_list %}\n                  <a class=\"topic-item\" href=\"{{ blog_tag_url(group.id, topic.slug) }}\">{{ topic.name }}</a>\n                  {% endfor %}\n                </div>\n                {% endif %}\n                <h3><a href=\"{{ content.absolute_url }}\">{{ content.name }}</a></h3>\n                <div class=\"preview-text\">{{ content.post_list_content|safe|striptags  }}</div>\n              </div> \n              {% endif %}\n            </div>\n          </div>                     \n        </div>\n\n        {% if loop.index == 3 %}\n        {% module \"module_form_subscribe\" path=\"/August_2019/Custom Modules/Blog - Subscribe Form\", label=\"Blog - Subscribe Form\", no_wrapper=True %}\n        {% endif %}\n        {% if loop.index == 6 %}\n        {% module \"module_cta_section\" path=\"/August_2019/Custom Modules/Blog - Listing CTA Section\", label=\"Blog - Listing CTA Section\", no_wrapper=True %}\n        {% endif %}\n\n        {% endfor %}\n      </div>\n\n      <!-- Pagination -->\n      <div class=\"pagination-section\">\n        <div class=\"btn-sec btn-loadmore\">More recent articles</div> <a class=\"btn-sec view-all\" href=\"{{ blog_all_posts_url(group.id) }}\">View all articles</a>\n      </div>\n    </div>\n  </div>\n</div>\n\n\n",
