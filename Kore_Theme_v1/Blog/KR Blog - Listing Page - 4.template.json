    }, {
      "0" : {
        "x" : 0,
        "w" : 12,
        "name" : "module_157348264692040",
        "label" : "Listing Top Section",
        "type" : "custom_widget",
        "params" : {
          "css_style" : "",
          "template_to_edit" : "listing",
          "css_id" : "",
          "css_class" : "",
          "schema_version" : 2,
          "path" : "@hubspot/blog_content",
          "per_widget_wrapper_html" : "",
          "blog_listing_source" : "<div class=\"listing-featured-section\">\n  <div class=\"max1080\">\n    <div class=\"featured-section-wrapper\">\n      <div class=\"top-section clearfix\">\n        <h1>The Commitment Matter Blog</h1>\n        <div class=\"listing-search-sec\">\n          <form action=\"/{{ site_settings.content_search_results_page_path }}\" class=\"clearfix\">\n            <input class=\"search\" type=\"search\" name=\"term\" placeholder=\"Search Articles...\">\n            <input class=\"search_btn\" type=\"submit\" value=\" \">\n          </form>\n        </div>\n      </div>\n      \n      {% set rec_posts = blog_recent_posts('{{ group.id }}', 1) %}\n      {% for rec_post in rec_posts %}\n      <div class=\"top-featured-post clearfix\">\n        <div class=\"col-float top-post mheight\" style=\"background-image: url('{{ rec_post.post_list_summary_featured_image }}');\">\n          <div class=\"post-date\">\n            <div class=\"month\"></div>{{ rec_post.publish_date|datetimeformat('%B') }} \n            <div class=\"day\">{{ rec_post.publish_date|datetimeformat('%e') }}</div>\n            <div class=\"year\">{{ rec_post.publish_date|datetimeformat('%Y') }}</div>\n          </div>\n        </div>\n        <div class=\"col-float top-post-body mheight\">\n          {% if rec_post.topic_list %}\n          <div id=\"topic-items\">\n            {% for topic in rec_post.topic_list %}\n            <a class=\"topic-item\" href=\"{{ blog_tag_url(group.id, topic.slug) }}\">{{ topic.name }}</a>\n            {% endfor %}\n          </div>\n          {% endif %}\n          <h2>{{ rec_post.name }}</h2>\n          <div class=\"preview-text\">{{ rec_post.post_list_content|safe|striptags  }}</div>\n          <a class=\"more-link\" href=\"{{ rec_post.absolute_url }}\">Read More</a>\n        </div>\n      </div>\n      {% endfor %}\n      \n    </div>\n  </div>\n</div>",
